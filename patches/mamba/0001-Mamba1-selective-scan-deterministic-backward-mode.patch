+#pragma once
+
+#include <ATen/ATen.h>
+
+// out[o, i] (+)= sum_{n=0}^{N-1} in[o, n, i], added sequentially in increasing n (fp32).
+// With accumulate=true the running sum starts from out's current value, so reducing consecutive
+// slices of n gives the same bits as reducing them all at once.
+void det_sum_middle(const float *in_ptr, float *out_ptr,
+                    int64_t outer, int64_t N, int64_t inner,
+                    int64_t in_outer_stride, int64_t in_n_stride, int64_t out_outer_stride,
+                    bool accumulate);
+
+// Fixed-order sum of a contiguous float32 / complex64 tensor over dimension 0.
+at::Tensor det_sum_dim0(const at::Tensor &in);
